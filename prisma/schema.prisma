generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  shortDescription String?
  longDescription  String?
  category         String?
  niche            String
  price            Float
  compareAtPrice   Float?
  supplierPrice    Float
  heroImage        String?
  trendScore       Int              @default(0)
  source           String?
  stripeProductId  String?          @unique
  stripePriceId    String?          @unique
  validationStatus String           @default("pending")
  cjProductId      String?
  cjVariantId      String?
  cjVariants       Json?
  
  // CJ Analytics & Sync
  cjSalesRank      Int?
  cjSupplierScore  Float?
  cjLastSyncedAt   DateTime?
  cjRawData        Json?
  primaryVariantId String?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  orderItems       OrderItem[]
  priceHistory     PriceLog[]
  reviews          Review[]
  suppliers        Supplier[]
  bundles          Bundle[]         @relation("BundleProducts")
  keywordClusters  KeywordCluster[] @relation("ProductToCluster")
  variants         ProductVariant[] // Added Relation
}

model ProductVariant {
  id                   String   @id @default(cuid())
  productId            String
  vid                  String   @unique
  sku                  String?
  label                String   // e.g., "XL / Red"
  color                String?
  size                 String?
  supplierPrice        Float
  retailPrice          Float
  cjStock              Int      @default(0)
  stripeVariantPriceId String?
  image                String?
  isDefault            Boolean  @default(false)
  
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model KeywordCluster {
  id              String    @id @default(cuid())
  keyword         String    @unique
  searchVolume    Int
  competition     String
  intent          String
  trend           String
  niche           String
  relatedKeywords String[]
  painPoint       String
  solutionAngle   String
  targetSlug      String    @unique
  targetPageType  String
  relatedSlugs    String[]
  source          String    @default("manual")
  aiContent       Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[] @relation("ProductToCluster")
}

model Supplier {
  id           String  @id @default(cuid())
  productId    String
  name         String
  url          String
  price        Float
  shippingDays Int     @default(14)
  isReliable   Boolean @default(false)
  isCheapest   Boolean @default(false)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Bundle {
  id             String    @id @default(cuid())
  title          String
  hook           String?
  price          Float
  compareAtPrice Float
  heroImage      String?
  status         String    @default("approved")
  createdAt      DateTime  @default(now())
  products       Product[] @relation("BundleProducts")
}

model Order {
  id              String      @id @default(cuid())
  stripeSessionId String      @unique
  customerName    String
  customerEmail   String
  customerPhone   String?
  totalAmount     Float
  status          String      @default("processing")
  trackingNumber  String?
  fulfillmentLog  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int     @default(1)
  priceAtSale Float
  supplierUrl String?
  cjVariantId String?
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
}

model PriceLog {
  id            String   @id @default(cuid())
  productId     String
  supplierPrice Float
  retailPrice   Float
  timestamp     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProcessedEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  source    String
  message   String
  meta      String?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  productSlug String
  rating      Int
  title       String?
  body        String
  authorName  String
  authorEmail String?
  verified    Boolean  @default(false)
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productSlug])
  @@index([status])
}

model Referral {
  id            String        @id @default(cuid())
  code          String        @unique
  ownerId       String
  ownerEmail    String
  ownerName     String?
  creditsEarned Float         @default(0)
  createdAt     DateTime      @default(now())
  uses          ReferralUse[]

  @@index([ownerId])
  @@index([code])
}

model ReferralUse {
  id             String   @id @default(cuid())
  referralId     String
  buyerEmail     String
  orderId        String?
  discountAmount Float
  creditAwarded  Float
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  referral       Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
}
