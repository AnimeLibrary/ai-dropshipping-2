// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  shortDescription  String?  @db.Text
  longDescription   String?  @db.Text
  category          String?
  niche             String
  price             Float
  compareAtPrice    Float?
  supplierPrice     Float
  heroImage         String?
  trendScore        Int      @default(0)
  source            String?  // e.g., 'kalodata', 'minea'
  
  // Fulfillment & Stripe Mapping
  stripeProductId   String?  @unique
  stripePriceId     String?  @unique
  validationStatus  String   @default("pending") // pending, approved, archived

  // CJ Dropshipping
  cjProductId       String?  // CJ product ID for API lookups
  cjVariantId       String?  // CJ variant ID for order placement
  
  // Relations
  suppliers         Supplier[]
  reviews           Review[]
  bundles           Bundle[]     @relation("BundleProducts")
  orderItems        OrderItem[]
  priceHistory      PriceLog[]
  keywordClusters   KeywordCluster[] @relation("ProductToCluster") // New Relation
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model KeywordCluster {
  id              String   @id @default(cuid())
  keyword         String   @unique
  searchVolume    Int
  competition     String   // low, medium, high
  intent          String   // informational, transactional, etc
  trend           String   // rising, stable, declining
  niche           String
  relatedKeywords String[] // Array of strings (Postgres supported)
  painPoint       String   @db.Text
  solutionAngle   String   @db.Text
  targetSlug      String   @unique
  targetPageType  String   // guide, problem, solution
  relatedSlugs    String[] // Array of slugs for internal linking
  source          String   @default("manual")
  aiContent       Json?    // Stores { story: string, faq: [], angles: [] }
  
  // Relations
  products        Product[] @relation("ProductToCluster")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Supplier {
  id            String   @id @default(cuid())
  productId     String
  name          String
  url           String
  price         Float
  shippingDays  Int      @default(14)
  isReliable    Boolean  @default(false)
  isCheapest    Boolean  @default(false)

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Bundle {
  id                String   @id @default(cuid())
  title             String
  hook              String?
  price             Float
  compareAtPrice    Float
  heroImage         String?
  
  // Relations
  products          Product[] @relation("BundleProducts")
  status            String    @default("approved")
  createdAt         DateTime  @default(now())
}

model Order {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  customerName    String
  customerEmail   String
  customerPhone   String?
  totalAmount     Float
  status          String   @default("processing") // processing, shipped, failed
  trackingNumber  String?
  fulfillmentLog  String?  @db.Text
  
  // Relations
  items           OrderItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String
  quantity      Int      @default(1)
  priceAtSale   Float
  supplierUrl   String?  // The specific URL used for fulfillment
  cjVariantId   String?  // CJ variant for auto-fulfillment

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id])
}

model PriceLog {
  id            String   @id @default(cuid())
  productId     String
  supplierPrice Float
  retailPrice   Float
  timestamp     DateTime @default(now())

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProcessedEvent {
  id            String   @id @default(cuid())
  eventId       String   @unique // Stripe Event ID
  type          String
  processedAt   DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String   // info, warn, error
  source    String   // which service/route
  message   String   @db.Text
  meta      String?  @db.Text // JSON string for extra data
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  productSlug String
  rating      Int      // 1-5
  title       String?
  body        String   @db.Text
  authorName  String
  authorEmail String?
  verified    Boolean  @default(false)
  status      String   @default("pending") // pending, approved, rejected
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productSlug])
  @@index([status])
}

model Referral {
  id            String        @id @default(cuid())
  code          String        @unique  // e.g. "VEX-AB3K"
  ownerId       String        // Clerk user ID
  ownerEmail    String
  ownerName     String?
  creditsEarned Float         @default(0)
  uses          ReferralUse[]
  createdAt     DateTime      @default(now())

  @@index([ownerId])
  @@index([code])
}

model ReferralUse {
  id             String   @id @default(cuid())
  referralId     String
  referral       Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  buyerEmail     String
  orderId        String?
  discountAmount Float    // How much the buyer saved (in $)
  creditAwarded  Float    // Store credit given to referrer
  status         String   @default("pending") // pending, confirmed
  createdAt      DateTime @default(now())

  @@index([referralId])
}
