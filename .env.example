# TrendDrop — Required Environment Variables
# Copy this to .env.local and fill in your keys.
# The system will show ❌ in the Health panel for any missing key.

# ─── DATABASE ────────────────────────────────────────────────
# Supabase / PlanetScale / Neon Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ─── STRIPE ──────────────────────────────────────────────────
# From: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."

# From: https://dashboard.stripe.com/webhooks — after adding your endpoint
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── LOCAL AI (LM Studio) ────────────────────────────────────
# Your LM Studio server URL — the AI agent won't work without this
AI_API_ENDPOINT="http://172.20.10.12:1234"

# ─── FULFILLMENT (AutoDS) ────────────────────────────────────
# From: https://app.autods.com/settings/api
# Without this: orders are queued locally (never pushed to AutoDS)
AUTODS_API_KEY=""

# ─── EMAIL ALERTS (Resend) ───────────────────────────────────
# From: https://resend.com/api-keys (free: 100 emails/day)
# Without this: alerts go to DB SystemLog only (visible in admin)
RESEND_API_KEY=""

# ─── SEO DATA (Serper) ───────────────────────────────────────
# From: https://serper.dev (needed for live saturation scoring)
# Without this: saturation uses static niche heuristics
SERPER_API_KEY=""

# ─── ADMIN SETTINGS ──────────────────────────────────────────
ADMIN_EMAIL="brannenguidry28@gmail.com"
FROM_EMAIL="alerts@trenddrop.store"
NEXT_PUBLIC_SITE_URL="https://trenddrop.store"

# ─── CLOUDFLARE ──────────────────────────────────────────────
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_ACCOUNT_ID=""
