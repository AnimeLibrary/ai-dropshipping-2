# Vexsen required environment variables
# Copy this to .env.local for local development or add the same keys in Vercel.

# Site
NEXT_PUBLIC_SITE_URL="https://vexsen.com"
FROM_EMAIL="alerts@vexsen.com"

# Clerk login
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."
ADMIN_EMAIL="owner@example.com"

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Store automation and supplier services
AUTODS_API_KEY=""
CJ_EMAIL=""
CJ_API_KEY=""

# AI/admin tools
AI_API_ENDPOINT="http://localhost:1234"
AI_API_KEY=""
SERPER_API_KEY=""

# Email alerts
RESEND_API_KEY=""

# Optional Supabase and Cloudflare
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_ACCOUNT_ID=""
